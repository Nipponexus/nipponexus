---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import { seoTitle, seoDesc } from '../lib/seo_meta';
import type { Festival } from '../lib/festivals';
import { getRelatedByPrefecture, getRelatedBySeason, getEventEnd } from '../lib/festivals';
import { prefEn } from '../data/pref_en';
import { eventLd } from '../lib/event_ld';

interface Props {
  festival: Festival;
  locale: 'ja' | 'en';
  contentHtml: string;
}
const { festival, locale, contentHtml } = Astro.props;

const isJa = locale === 'ja';
const siteName = isJa ? 'Nipponexus 日本の祭り図鑑' : 'Nipponexus - Festivals of Japan';
const title = isJa ? festival.label_ja : (festival.label_en || festival.label_ja);
const desc = seoDesc(festival, locale);

const otherLocale = isJa ? 'en' : 'ja';
const otherSlug = isJa ? festival.slug_en : festival.slug_ja;
const otherUrl = otherSlug ? `https://nipponexus.com/${otherLocale === 'ja' ? '' : 'en/'}${otherSlug}/` : null;
const selfUrl = `https://nipponexus.com/${isJa ? '' : 'en/'}${isJa ? festival.slug_ja : festival.slug_en}/`;
const ee = getEventEnd(festival.qid);
const KIND: Record<string, [string, string]> = {
  '終了': ['終了', 'Ended'], '休止': ['休止', 'Suspended'], '改称': ['改称', 'Renamed'],
};
const kj = ee?.kind ? (KIND[ee.kind] ?? [ee.kind, ee.kind]) : null;
let periodLabel: string | null = null;
if (festival.inception_year && ee?.end_year) {
  periodLabel = isJa
    ? `${festival.inception_year}年〜${ee.end_year}年（${kj![0]}）`
    : `${festival.inception_year}–${ee.end_year} (${kj![1]})`;
} else if (ee?.end_year) {
  periodLabel = isJa ? `${ee.end_year}年${kj![0]}` : `${kj![1]} ${ee.end_year}`;
} else if (festival.inception_year) {
  periodLabel = isJa ? `${festival.inception_year}年〜` : `Since ${festival.inception_year}`;
}

const pageTitle = seoTitle(festival, locale);

// JSON-LD Event schema
const jsonLd = eventLd(festival as any, isJa, selfUrl, desc);

// 季節ラベル
const seasonLabels: Record<string, { ja: string; en: string }> = {
  spring: { ja: '春', en: 'Spring' },
  summer: { ja: '夏', en: 'Summer' },
  autumn: { ja: '秋', en: 'Autumn' },
  winter: { ja: '冬', en: 'Winter' },
};
const seasonLabel = festival.season && seasonLabels[festival.season]
  ? seasonLabels[festival.season][locale]
  : null;

const locationLabel = isJa ? festival.location_label_ja : (festival.location_label_en || festival.location_label_ja);
const prefectureLabel = isJa ? festival.prefecture : prefEn(festival.prefecture);

// 関連祭り（内部リンク・回遊強化）
const relatedPref = getRelatedByPrefecture(festival.prefecture, festival.qid, locale, 6);
const relatedSeason = getRelatedBySeason(festival.season, festival.qid, locale, 6);
const relSlugCol = isJa ? 'slug_ja' : 'slug_en';
const relUrl = (f: Festival) => `/${isJa ? '' : 'en/'}${(isJa ? f.slug_ja : f.slug_en)}/`;
const relName = (f: Festival) => isJa ? f.label_ja : (f.label_en || f.label_ja);
const prefLinkLabel = festival.prefecture;
const seasonLinkLabel = seasonLabel;
---
<BaseLayout
  title={pageTitle}
  description={desc}
  locale={locale}
  canonical={selfUrl}
  altLang={otherUrl || undefined}
  ogImage={festival.image_url || undefined}
>
  <Breadcrumb festival={festival} locale={locale} />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} slot="head" />}

  <section
    class="article-hero"
    style={festival.image_url
      ? `background-image: linear-gradient(135deg, rgba(28,25,23,0.75) 0%, rgba(153,27,27,0.75) 100%), url('${festival.image_url}'); background-size: cover; background-position: center;`
      : ''}
  >
    <div class="article-hero-content">
      <nav style="font-size:0.85rem;opacity:0.85;margin-bottom:1rem;">
        <a href={isJa ? '/' : '/en/'} style="color:white;">{isJa ? 'ホーム' : 'Home'}</a>
        {' / '}
        <a href={isJa ? '/index/region/' : '/en/index/region/'} style="color:white;">{isJa ? '索引' : 'Index'}</a>
        {' / '}
        <span style="opacity:0.7;">{title}</span>
      </nav>
      <h1>{title}</h1>
      <div class="article-meta">
        {locationLabel && <span>📍 {locationLabel}</span>}
        {prefectureLabel && prefectureLabel !== locationLabel && <span>🗾 {prefectureLabel}</span>}
        {seasonLabel && <span>🍃 {seasonLabel}</span>}
        {periodLabel && <span>📜 {periodLabel}</span>}
      </div>
    </div>
  </section>

  {festival.image_url && (
    <p style="max-width:var(--content-width,760px);margin:0.6rem auto 0;padding:0 1rem;font-size:0.78rem;color:var(--color-sumi-light);line-height:1.6;">
      {isJa ? '見出し画像: ' : 'Header image: '}
      <a href={festival.image_credit_url || '#'} target="_blank" rel="noopener noreferrer"
         style="color:inherit;">Wikimedia Commons</a>
      {' / '}
      {festival.image_author && festival.image_author !== '不明'
        ? festival.image_author
        : (isJa ? '作者不明' : 'Unknown author')}
      {' / '}
      {festival.image_license || (isJa ? 'ライセンス不明' : 'Unknown license')}
    </p>
  )}

  <article class="article-body bg-asanoha">
    {contentHtml ? (
      <div set:html={contentHtml}></div>
    ) : (
      <p style="color:var(--color-sumi-light);font-style:italic;">
        {isJa ? '詳細記事は準備中です。' : 'Detailed article coming soon.'}
      </p>
    )}

    <hr style="margin:3rem 0 2rem;border:none;border-top:2px solid var(--color-shu);opacity:0.3;" />

    <section style="background:var(--color-washi-warm);padding:1.5rem;border-radius:8px;margin-bottom:2rem;">
      <h3 style="margin-top:0;color:var(--color-kincha);">
        {isJa ? '出典・関連リンク' : 'Sources & Related Links'}
      </h3>
      <ul style="list-style:none;padding-left:0;margin:0;">
        <li style="margin-bottom:0.5rem;">
          📚 {isJa ? '出典' : 'Sources'}: Wikipedia, Wikidata (CC BY-SA 4.0)
        </li>
        {festival.wikipedia_ja && (
          <li style="margin-bottom:0.5rem;">
            🇯🇵 <a href={festival.wikipedia_ja} target="_blank" rel="noopener">Wikipedia (日本語)</a>
          </li>
        )}
        {festival.wikipedia_en && (
          <li style="margin-bottom:0.5rem;">
            🌐 <a href={festival.wikipedia_en} target="_blank" rel="noopener">Wikipedia (English)</a>
          </li>
        )}
        {otherUrl && (
          <li style="margin-bottom:0.5rem;">
            🔁 {isJa ? <>English version: <a href={otherUrl}>{festival.label_en || festival.label_ja}</a></> : <>日本語版: <a href={otherUrl}>{festival.label_ja}</a></>}
          </li>
        )}
      </ul>
    </section>

    {(relatedPref.length > 0 || relatedSeason.length > 0) && (
      <section style="margin-bottom:2rem;">
        {relatedPref.length > 0 && (
          <div style="margin-bottom:1.5rem;">
            <h3 style="color:var(--color-kincha);border-bottom:2px solid var(--color-shu);padding-bottom:0.4rem;">
              {isJa ? `${prefLinkLabel}の他の祭り` : `More festivals in ${prefLinkLabel}`}
            </h3>
            <ul style="list-style:none;padding-left:0;margin:0.8rem 0 0;display:flex;flex-wrap:wrap;gap:0.6rem;">
              {relatedPref.map((f) => (
                <li>
                  <a href={relUrl(f)} class="btn btn-outline" style="font-size:0.9rem;padding:0.35rem 0.9rem;">{relName(f)}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
        {relatedSeason.length > 0 && seasonLinkLabel && (
          <div>
            <h3 style="color:var(--color-kincha);border-bottom:2px solid var(--color-shu);padding-bottom:0.4rem;">
              {isJa ? `${seasonLinkLabel}の祭り` : `${seasonLinkLabel} festivals`}
            </h3>
            <ul style="list-style:none;padding-left:0;margin:0.8rem 0 0;display:flex;flex-wrap:wrap;gap:0.6rem;">
              {relatedSeason.map((f) => (
                <li>
                  <a href={relUrl(f)} class="btn btn-outline" style="font-size:0.9rem;padding:0.35rem 0.9rem;">{relName(f)}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <div style="text-align:center;margin-top:2rem;">
      <a href={isJa ? '/index/region/' : '/en/index/region/'} class="btn btn-outline">
        {isJa ? '← 他の祭りを探す' : '← Explore More Festivals'}
      </a>
    </div>
  </article>
</BaseLayout>
