---
import { ADSENSE_PUB_ID } from '../config/ads';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import '../styles/global.css';
import HeadIcons from '../components/HeadIcons.astro';

interface Props {
  title: string;
  description?: string;
  locale?: 'ja' | 'en';
  canonical?: string;
  altLang?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Nipponexus - Japanese festivals and culture database',
  locale = 'ja',
  canonical,
  altLang,
  ogImage = '/og-default.jpg',
} = Astro.props;

const siteUrl = 'https://nipponexus.com';
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
---
<!doctype html>
<html lang={locale}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
    <HeadIcons />
  {altLang && <link rel="alternate" hreflang={locale === 'ja' ? 'en' : 'ja'} href={altLang} />}
  <link rel="alternate" hreflang="x-default" href={siteUrl} />

  <meta property="og:site_name" content="Nipponexus" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content="website" />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@400;700&family=Inter:wght@400;600&display=swap" />

  {ADSENSE_PUB_ID && <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_PUB_ID}`} crossorigin="anonymous"></script>}
  <slot name="head" />
</head>
<body>
  <Header locale={locale} />
  <main>
    <slot />
  </main>
  <Footer locale={locale} />
  <ScrollReveal />
</body>
</html>
