---
import type { GroupedFestivals } from '../lib/festivals';
interface Props {
  groups: GroupedFestivals[];
  locale: 'ja' | 'en';
}
import { prefEn } from '../lib/i18n_geo';
const { groups, locale } = Astro.props;
const isJa = locale === 'ja';
---
{groups.length > 1 && (
  <nav class="index-jump" aria-label={isJa ? 'ジャンプリンク' : 'Jump links'} style="margin-bottom:2rem;padding:1rem 1.2rem;background:rgba(255,255,255,0.6);border-radius:8px;box-shadow:0 1px 4px rgba(0,0,0,0.05);">
    <div style="font-size:0.85rem;color:var(--color-sumi-light);margin-bottom:0.6rem;">
      {isJa ? '一覧へジャンプ' : 'Jump to a group'}
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:0.4rem;">
      {groups.map(g => (
        <a href={'#' + g.key} style="display:inline-block;padding:0.3rem 0.7rem;background:white;border:1px solid var(--color-shu);border-radius:999px;font-size:0.85rem;color:var(--color-shu);text-decoration:none;white-space:nowrap;">
          {g.label}<span style="color:var(--color-sumi-light);margin-left:0.3rem;font-size:0.75rem;">{g.festivals.length}</span>
        </a>
      ))}
    </div>
  </nav>
)}
{groups.map(g => (
  <section class="reveal" id={g.key} style="margin-bottom:2rem;">
    <h2 style="display:flex;align-items:baseline;gap:1rem;margin-bottom:1rem;border-bottom:3px solid var(--color-shu);padding-bottom:0.5rem;">
      {g.label}
      <span style="font-size:1rem;color:var(--color-sumi-light);font-weight:normal;">
        {isJa ? `${g.festivals.length} 件` : `${g.festivals.length} ${g.festivals.length === 1 ? 'festival' : 'festivals'}`}
      </span>
    </h2>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:0.8rem;">
      {g.festivals.map(f => {
        const slug = locale === 'ja' ? f.slug_ja : f.slug_en;
        const name = locale === 'ja' ? f.label_ja : (f.label_en || f.label_ja);
        const sub = f.prefecture ? (isJa ? f.prefecture : prefEn(f.prefecture)) : (isJa ? '日本' : 'Japan');
        const isPublished = !!slug && (f.status === 'drafted' || f.status === 'published');
        const href = isPublished ? (locale === 'ja' ? `/${slug}/` : `/en/${slug}/`) : null;
        return href ? (
          <a href={href} style="display:block;padding:0.8rem 1rem;background:white;border-radius:6px;box-shadow:0 1px 4px rgba(0,0,0,0.06);text-decoration:none;color:var(--color-sumi);transition:transform 0.2s,box-shadow 0.2s;">
            <div style="font-family:var(--font-serif);font-size:1rem;font-weight:600;color:var(--color-shu);">{name}</div>
            <div style="font-size:0.8rem;color:var(--color-sumi-light);margin-top:0.2rem;">{sub}</div>
          </a>
        ) : (
          <div style="padding:0.8rem 1rem;background:#f5f5f4;border-radius:6px;opacity:0.65;">
            <div style="font-family:var(--font-serif);font-size:1rem;font-weight:500;color:var(--color-sumi);">
              {name}
            </div>
            <div style="font-size:0.8rem;color:var(--color-sumi-light);margin-top:0.2rem;">{sub}</div>
          </div>
        );
      })}
    </div>
  </section>
))}
