---
import BaseLayout from '../../layouts/BaseLayout.astro';
import IndexTabs from '../../components/IndexTabs.astro';
import IndexSection from '../../components/IndexSection.astro';
import { getAllFestivalsForIndex, groupBySeason } from '../../lib/festivals';
const all = getAllFestivalsForIndex('ja');
const groups = groupBySeason(all, 'ja');
---
<BaseLayout
  title="季節から探す | Nipponexus 日本の祭り図鑑"
  description="春・夏・秋・冬それぞれの季節に開催される日本の祭りを探せる索引ページ。"
  locale="ja"
  altLang="https://nipponexus.com/en/index/season/"
>
  <section class="index-hero">
    <div class="container">
      <h1>季節から探す</h1>
      <p>四季の移ろいとともに巡る、日本の祭り。</p>
    </div>
  </section>
  <div class="container" style="padding-top:2rem;">
    <IndexTabs active="season" locale="ja" />
    <IndexSection groups={groups} locale="ja" />
  </div>
</BaseLayout>
