---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import IndexTabs from '../../../components/IndexTabs.astro';
import IndexSection from '../../../components/IndexSection.astro';
import { getAllFestivalsForIndex, groupByRegion } from '../../../lib/public_index';
const all = getAllFestivalsForIndex('en');
const groups = groupByRegion(all, 'en');
---
<BaseLayout
  title="Browse by Region | Nipponexus"
  description="Discover Japanese festivals across 9 regions: Hokkaido, Tohoku, Kanto, Chubu, Kinki, Chugoku, Shikoku, Kyushu, and Okinawa."
  locale="en"
  altLang="https://nipponexus.com/index/region/"
>
  <section class="index-hero index-hero--region">
    <div class="container">
      <h1>Browse by Region</h1>
      <p>Explore Japanese festivals across 9 distinct regions.</p>
    </div>
  </section>
  <div class="container" style="padding:2rem 1rem 1rem;">
    <IndexTabs active="region" locale="en" />
    <IndexSection groups={groups} locale="en" />
  </div>
</BaseLayout>
