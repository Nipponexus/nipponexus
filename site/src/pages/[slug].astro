---
import FestivalLayout from '../layouts/FestivalLayout.astro';
import { getDraftedFestivals, getFestivalBySlug } from '../lib/festivals';
import { marked } from 'marked';

export async function getStaticPaths() {
  const festivals = getDraftedFestivals('ja');
  return festivals.map(f => ({ params: { slug: f.slug_ja! } }));
}

const { slug } = Astro.params;
const festival = getFestivalBySlug(slug!, 'ja');
if (!festival) return Astro.redirect('/404');
const contentHtml = festival.manual_content_ja ? marked.parse(festival.manual_content_ja) : '';
---
<FestivalLayout festival={festival} locale="ja" contentHtml={contentHtml as string} />
